# Copy to .env and adjust as needed. Nothing in this file is a business
# constant (draft limits, port lists, etc.) — those live in backend/seed_data/*.yaml
# per the plan's "no hardcoded business constants" principle.

# --- Postgres / TimescaleDB ---
POSTGRES_USER=freightiq
POSTGRES_PASSWORD=freightiq
POSTGRES_DB=freightiq
POSTGRES_PORT=5432

# Used directly by the backend when running outside docker-compose
# (docker-compose overrides this with the `db` service hostname).
DATABASE_URL=postgresql+psycopg://freightiq:freightiq@localhost:5432/freightiq

# --- Redis / Celery ---
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- API ---
API_PORT=8000
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Frontend (Phase 6) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Data strategy ---
# Gates scripts/seed_synthetic_data.py and the ingestion fallback chain
# (Section 2.2 / 5.3 of the plan). Set false only once real connector
# credentials below are populated.
USE_SYNTHETIC_DATA=true

# --- Third-party data source credentials (Phase 2+, all optional/stubbed) ---
TRADING_ECONOMICS_API_KEY=
EIA_API_KEY=
AISHUB_API_KEY=
MARINETRAFFIC_API_KEY=
INCOIS_API_KEY=

# --- Model registry (MVP: filesystem artifact store) ---
MODEL_REGISTRY_ARTIFACT_DIR=./model_artifacts

# --- Auth (wired up in Phase 5) ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
